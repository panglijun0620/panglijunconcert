MYSQL_DATABASE=concert
MYSQL_ROOT_PASSWORD=replace-with-generated-root-password
DB_WEB_USERNAME=concert_web
DB_WEB_PASSWORD=replace-with-generated-readonly-password
DB_PUBLISHER_USERNAME=concert_publisher
DB_PUBLISHER_PASSWORD=replace-with-generated-publisher-password
DB_MIGRATION_USERNAME=concert_migration
DB_MIGRATION_PASSWORD=replace-with-generated-migration-password
MYSQL_HOST_PORT=13306
REDIS_PASSWORD=replace-with-generated-redis-password
ADMIN_API_ENABLED=false

# 风险解读的大模型配置。默认关闭，不填任何值也能正常跑（解读走规则模板）。
# 开启前先在模型服务控制台创建 API Key，再把 AI_ENABLED 改成 true。
# AI_API_KEY 只写在服务器本地的 .env 里，不要提交到仓库。
AI_ENABLED=false
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4-flash
AI_API_KEY=
WEB_PORT=8080
HDFS_UI_PORT=9870
YARN_UI_PORT=8088
JOB_HISTORY_UI_PORT=19888
DATANODE_1_UI_PORT=9864
DATANODE_2_UI_PORT=9865
NODEMANAGER_1_UI_PORT=8042
NODEMANAGER_2_UI_PORT=8043
